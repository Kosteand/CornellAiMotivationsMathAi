# ----------------------------------------------------------------------
# 6b. Proxy-magnitude-statistics check - only runs if
#     CHECK_MAGNITUDE_PROXIES is True (see the config block at the top of
#     this file). Reads df_large (the raw, un-logged ratios straight from
#     Utilities.indifference_data) plus best_name/best_model (Section 3's
#     AIC-ranked selection) and prints a standalone report - doesn't
#     modify df/df_plot/df_fit/models/best_model themselves, or anything
#     below.
# ----------------------------------------------------------------------

def _fit_base_model(best_name, best_model, x, y):
    """Refit the SELECTED model shape (best_name) FROM SCRATCH on (x, y) -
    not reusing best_model's own fitted params, just its shape/bounds -
    since this check needs the base model refit on exactly the rows this
    check itself is using (the rows where ALL magnitude measures are
    available), not whatever rows Section 3's original fit happened to
    use. Returns (fit, predict_fn, params_array) where predict_fn takes an
    array of x values and predict_fn is only ever called with the SAME
    inputs the fit statistics below were computed from, or a held-out
    array of x values for the generalization check."""
    if best_name in _OLS_MODEL_TERMS:
        terms = _OLS_MODEL_TERMS[best_name]
        design = np.column_stack([f(x) for _, f in terms])
        fit = sm.OLS(y, design).fit()

        def predict(x_ho):
            d = np.column_stack([f(x_ho) for _, f in terms])
            return fit.predict(d)

        return fit, predict, np.asarray(fit.params)

    if best_name in _NONLINEAR_LOOKUP:
        _, func, param_names, p0_orig, bounds_orig = _NONLINEAR_LOOKUP[best_name]
        # Seed from best_model's own fitted params (a warm start - the
        # row subset here may differ slightly from Section 3's, since
        # this check restricts to rows where every magnitude measure is
        # available), falling back to the model's original p0 if that
        # fails for any reason.
        try:
            p0 = [best_model.params[n] for n in param_names]
        except (AttributeError, KeyError, TypeError):
            p0 = p0_orig
        fit = NonlinearFitResult(best_name, func, param_names, x, y, p0, bounds=bounds_orig)

        def predict(x_ho):
            return func(x_ho, *fit.popt)

        return fit, predict, np.asarray(fit.popt)

    raise ValueError(f"no base-model recipe for best_name={best_name!r} "
                      f"(expected one of {list(_OLS_MODEL_TERMS) + list(_NONLINEAR_LOOKUP)})")


def _fit_augmented_model(best_name, base_fit, x, logm, y):
    """Fit the SAME model shape as _fit_base_model, PLUS an additive
    `+ q * logm` term, with every parameter (base params AND q) estimated
    jointly - not q alone with the base params held fixed at base_fit's
    values (base_fit's popt/params are only used to seed the nonlinear
    curve_fit's starting point, for faster/more reliable convergence).
    Returns (fit, predict_fn, params_array) - params_array's LAST entry is
    always q."""
    if best_name in _OLS_MODEL_TERMS:
        terms = _OLS_MODEL_TERMS[best_name]
        design = np.column_stack([f(x) for _, f in terms] + [logm])
        fit = sm.OLS(y, design).fit()

        def predict(x_ho, logm_ho):
            d = np.column_stack([f(x_ho) for _, f in terms] + [logm_ho])
            return fit.predict(d)

        return fit, predict, np.asarray(fit.params)

    if best_name in _NONLINEAR_LOOKUP:
        _, func, param_names, p0_orig, bounds_orig = _NONLINEAR_LOOKUP[best_name]

        def aug_func(X, *params):
            xx, mm = X
            base_params = params[:len(param_names)]
            q = params[-1]
            return func(xx, *base_params) + q * mm

        aug_param_names = param_names + ["q_magnitude"]
        aug_p0 = list(base_fit.popt) + [0.1]
        if bounds_orig is not None:
            lo, hi = bounds_orig
            aug_bounds = (list(lo) + [-np.inf], list(hi) + [np.inf])
        else:
            aug_bounds = None
        fit = NonlinearFitResult(best_name + " + magnitude", aug_func, aug_param_names,
                                  np.vstack([x, logm]), y, aug_p0, bounds=aug_bounds)

        def predict(x_ho, logm_ho):
            return aug_func(np.vstack([x_ho, logm_ho]), *fit.popt)

        return fit, predict, np.asarray(fit.popt)

    raise ValueError(f"no augmented-model recipe for best_name={best_name!r} "
                      f"(expected one of {list(_OLS_MODEL_TERMS) + list(_NONLINEAR_LOOKUP)})")


def _run_augmented_check_for_column(df_large, best_name, best_model, measures,
                                     fit_mask, heldout_mask, x_col):
    """The full 'augment the selected model with each magnitude measure'
    check, parametrized by WHICH column plays the role of x (normally
    X_COLUMN, but see CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS - this lets the
    same check run once per column in ACTOR_RATIO_OPTIONS). Refits
    best_name's shape FROM SCRATCH (not reusing Section 3's best_model fit
    directly) on the common subset of rows where x_col AND every one of
    the six magnitude measures are available, so (a) the base-vs-augmented
    comparison for each measure is apples-to-apples against the SAME base
    fit, and (b) every measure's ΔAIC/ΔR² is directly comparable to every
    other measure's, since they all share one base. Each measure is then
    refit as an ADDITIVE augmentation of that base shape - e.g. if
    best_name == "Tanh", this fits logM = a*tanh(b*x) + q*log(measure_ratio)
    with a, b, q ALL estimated jointly (not q alone with a, b held fixed
    from the base fit - the base fit's params are only used as a
    curve_fit warm start). Prints the fitted coefficients and a
    human-readable formula for ALL 7 possible outcomes - the plain base
    model, plus each of the 6 augmented variants - then compares each
    augmented variant against the shared base fit (q's own significance,
    ΔAIC, ΔR², and the held-out RMSE change). Returns the numeric
    comparison as a DataFrame, or None if there weren't enough rows /
    the base refit failed."""
    measure_cols = list(measures.keys())
    common = df_large.loc[fit_mask, [x_col] + measure_cols + ["logM"]].dropna()
    for c in [x_col] + measure_cols:
        common = common[common[c] > 0]

    if len(common) < 5:
        print(f"(fewer than 5 rows have {x_col} AND all six magnitude "
              f"measures available - skipping the selected-model "
              f"augmentation check for x_col={x_col!r}.)")
        return None

    x = np.log(common[x_col].astype(float)).to_numpy()
    y = common["logM"].astype(float).to_numpy()

    try:
        base_fit, predict_base, base_params = _fit_base_model(best_name, best_model, x, y)
    except (RuntimeError, ValueError) as e:
        print(f"(refitting {best_name} on the common magnitude-available "
              f"subset for x_col={x_col!r} failed: {e} - skipping.)")
        return None

    param_names = _param_names_for(best_name)
    base_formula = _format_model_formula(best_name, base_params)

    print("=" * 80)
    print(f"MAGNITUDE-RATIO-ON-TOP-OF-SELECTED-MODEL CHECK "
          f"(x = log({x_col}); base model: {best_name}, refit from scratch on "
          f"n={len(common)} rows where {x_col} and all six magnitude measures "
          f"are available; augmented: same shape + q*log(measure_ratio), all "
          f"params refit jointly; fit excludes heatmap: {FIT_EXCLUDE_ALL_HEATMAP})")
    print("=" * 80)
    print(f"\nCoefficients and formulas for all {len(measures) + 1} possible "
          f"outcomes (x = log({x_col})):\n")
    print(f"  [Base, no magnitude term] "
          + ", ".join(f"{n}={v:.4f}" for n, v in zip(param_names, base_params)))
    print(f"      {base_formula}")

    biv_rows = []
    for col, label in measures.items():
        logm = np.log(common[col].astype(float)).to_numpy()

        try:
            aug_fit, predict_aug, aug_params = _fit_augmented_model(best_name, base_fit, x, logm, y)
        except (RuntimeError, ValueError) as e:
            print(f"\n  [+ {label} ({col})] fit failed ({e}) - skipped.")
            continue

        q_hat = float(aug_params[-1])
        q_pvalue = float(aug_fit.pvalues[-1])
        aug_formula = _format_model_formula(best_name, aug_params[:-1], magnitude_col=col, q=q_hat)

        print(f"\n  [+ {label} ({col})] "
              + ", ".join(f"{n}={v:.4f}" for n, v in zip(param_names, aug_params[:-1]))
              + f", q={q_hat:.4f} (p={q_pvalue:.4f})")
        print(f"      {aug_formula}")

        delta_aic = float(aug_fit.aic - base_fit.aic)
        delta_r2 = float(aug_fit.rsquared - base_fit.rsquared)

        resid_base = y - np.asarray(predict_base(x))
        resid_aug = y - np.asarray(predict_aug(x, logm))
        rmse_base = float(np.sqrt(np.mean(resid_base ** 2)))
        rmse_aug = float(np.sqrt(np.mean(resid_aug ** 2)))

        heldout_delta_rmse = n_heldout_biv = None
        if FIT_EXCLUDE_ALL_HEATMAP:
            ho = df_large.loc[heldout_mask, [x_col, col, "logM"]].dropna()
            ho = ho[(ho[x_col] > 0) & (ho[col] > 0)]
            n_heldout_biv = len(ho)
            if n_heldout_biv > 0:
                hx = np.log(ho[x_col].astype(float)).to_numpy()
                hlogm = np.log(ho[col].astype(float)).to_numpy()
                hy = ho["logM"].astype(float).to_numpy()
                resid_ho_base = hy - np.asarray(predict_base(hx))
                resid_ho_aug = hy - np.asarray(predict_aug(hx, hlogm))
                rmse_ho_base = float(np.sqrt(np.mean(resid_ho_base ** 2)))
                rmse_ho_aug = float(np.sqrt(np.mean(resid_ho_aug ** 2)))
                heldout_delta_rmse = rmse_ho_aug - rmse_ho_base

        biv_rows.append({
            "measure": label,
            "column": col,
            "n_fit": len(common),
            "q_magnitude": q_hat,
            "q_pvalue": q_pvalue,
            "r2_base": float(base_fit.rsquared),
            "r2_augmented": float(aug_fit.rsquared),
            "delta_r2": delta_r2,
            "aic_base": float(base_fit.aic),
            "aic_augmented": float(aug_fit.aic),
            "delta_aic": delta_aic,
            "rmse_base": rmse_base,
            "rmse_augmented": rmse_aug,
            "n_heldout": n_heldout_biv,
            "heldout_delta_rmse": heldout_delta_rmse,
        })
    print()

    biv_report = pd.DataFrame(biv_rows).sort_values("delta_aic").reset_index(drop=True)
    biv_report.index += 1
    biv_report.index.name = "Rank (by ΔAIC, more negative = adds more)"

    print("=" * 80)
    print(f"MAGNITUDE-RATIO-ON-TOP-OF-SELECTED-MODEL (x_col={x_col}): numeric comparison")
    print("=" * 80)
    with pd.option_context("display.width", 200, "display.max_columns", None):
        print(biv_report[["measure", "column", "n_fit", "q_magnitude",
                           "q_pvalue", "delta_r2", "delta_aic", "rmse_base",
                           "rmse_augmented"]])
    if FIT_EXCLUDE_ALL_HEATMAP and not biv_report.empty:
        with pd.option_context("display.width", 200, "display.max_columns", None):
            print("\nGeneralization to held-out heatmap pairs "
                  "(heldout_delta_rmse < 0 means adding the measure also helps out-of-sample):")
            print(biv_report[["measure", "column", "n_heldout", "heldout_delta_rmse"]])
    if not biv_report.empty:
        n_sig = int((biv_report["q_pvalue"] < 0.05).sum())
        print(f"\n{n_sig}/{len(biv_report)} magnitude measures have a statistically "
              f"significant (p<0.05) coefficient q ALONGSIDE the {best_name} model "
              f"fit on x=log({x_col}) - i.e. carry information that model doesn't "
              f"already capture, at that threshold.")
        best_biv = biv_report.iloc[0]
        print(f"Largest ΔAIC improvement: {best_biv['measure']} ({best_biv['column']}), "
              f"ΔAIC={best_biv['delta_aic']:.3f}, ΔR²={best_biv['delta_r2']:.4f}, "
              f"q={best_biv['q_magnitude']:.4f} (p={best_biv['q_pvalue']:.4f}).")
    print()

    return biv_report


def check_magnitude_proxies(df_large: pd.DataFrame, best_name=None, best_model=None):
    """Two checks on the six candidate "proxy magnitude" ratios -
    E[average entry] (avg_ratio), E[largest entry] (max_ratio), E[L1
    norm] (l1_ratio), E[L2 norm] (l2_ratio), E[RMS] (rms_ratio),
    E[standard deviation] (std_ratio), all sourced from
    Utilities.weight_norm_data.expected_magnitude() via
    Utilities.indifference_data.compute_ratios():

    1. UNIVARIATE - fit the SAME zero-intercept log-log model this file
       uses for X_COLUMN, ``logM = p * log(measure_ratio)``, alone, and
       report how well each measure predicts logM by itself: fitted
       exponent p, R² and RMSE on the fit data, plus (when
       FIT_EXCLUDE_ALL_HEATMAP is True) an out-of-sample RMSE/MAE on the
       excluded heatmap-involved pairs.

    2. AUGMENTED-SELECTED-MODEL - takes best_name/best_model (Section 3's
       AIC-ranked selection - whichever shape that turned out to be, e.g.
       "Tanh") and REFITS THAT EXACT SHAPE FROM SCRATCH (not reusing
       Section 3's fitted params - see _fit_base_model) on the common
       subset of rows where every one of the six magnitude measures is
       available, then, for each measure, fits the SAME shape again with
       an additive ``+ q*log(measure_ratio)`` term, ALL parameters
       (including q) estimated JOINTLY, e.g. best_name == "Tanh" gives
       ``logM = a*tanh(b*x) + q*log(measure_ratio)`` with a, b, q all fit
       together (the base fit's params are only used as a curve_fit warm
       start, not held fixed). Prints the fitted coefficients and a
       human-readable formula for ALL 7 possible outcomes - the plain
       base model, plus each of the 6 augmented variants - then compares
       each augmented variant against the shared base fit (q's own
       significance, ΔAIC, ΔR², and the held-out RMSE change), to see
       whether the measure adds anything ON TOP of a base model rather
       than whether it's a good predictor in isolation. By default this
       runs once, against best_name/X_COLUMN only. Two independent
       booleans widen it: CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS runs it
       once for EACH column in ACTOR_RATIO_OPTIONS (actor_ratio,
       layer2_ratio, action_net_ratio, total_ratio) instead of just
       X_COLUMN; CHECK_MAGNITUDE_ON_ALL_MODELS runs it once for EVERY
       model shape in `models` (Linear, Quadratic, Cubic, Cubic (no x²),
       Tanh, Rational saturation, Shifted power, Linear+log) instead of
       just best_name. Both True checks every model shape against every
       actor-ratio column. Pass best_name/best_model=None (the default)
       to skip this half and only run the univariate check.

    Both use the same fit-inclusion rule as the main X_COLUMN fit above
    (FIT_EXCLUDE_ALL_HEATMAP) so all checks are directly comparable.
    Returns (univariate_report, bivariate_result), where bivariate_result
    is a single DataFrame (best_name against X_COLUMN only) unless either
    CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS or CHECK_MAGNITUDE_ON_ALL_MODELS
    is True, in which case it's a nested dict {column: {model_name:
    DataFrame}}."""
    measures = {
        "avg_ratio": "E[average entry]",
        "max_ratio": "E[largest entry]",
        "l1_ratio": "E[L1 norm]",
        "l2_ratio": "E[L2 norm]",
        "rms_ratio": "E[RMS]",
        "std_ratio": "E[standard deviation]",
    }

    fit_mask = ~df_large["is_heatmap"] if FIT_EXCLUDE_ALL_HEATMAP else pd.Series(True, index=df_large.index)
    heldout_mask = df_large["is_heatmap"] if FIT_EXCLUDE_ALL_HEATMAP else pd.Series(False, index=df_large.index)

    rows = []
    for col, label in measures.items():
        fit_sub = df_large.loc[fit_mask, [col, "logM"]].dropna()
        fit_sub = fit_sub[fit_sub[col] > 0]
        if len(fit_sub) < 3:
            print(f"  {label} ({col}): fewer than 3 usable points - skipped.")
            continue

        x_fit = np.log(fit_sub[col].astype(float))
        y_fit = fit_sub["logM"].astype(float)
        model = sm.OLS(y_fit.to_numpy(), x_fit.to_numpy().reshape(-1, 1)).fit()
        p_hat = float(model.params[0])
        resid_fit = y_fit.to_numpy() - model.predict(x_fit.to_numpy().reshape(-1, 1))
        rmse_fit = float(np.sqrt(np.mean(resid_fit ** 2)))
        mae_fit = float(np.mean(np.abs(resid_fit)))

        rmse_heldout = mae_fit_heldout = n_heldout = None
        if FIT_EXCLUDE_ALL_HEATMAP:
            heldout_sub = df_large.loc[heldout_mask, [col, "logM"]].dropna()
            heldout_sub = heldout_sub[heldout_sub[col] > 0]
            n_heldout = len(heldout_sub)
            if n_heldout > 0:
                x_ho = np.log(heldout_sub[col].astype(float))
                y_ho = heldout_sub["logM"].astype(float)
                resid_ho = y_ho.to_numpy() - p_hat * x_ho.to_numpy()
                rmse_heldout = float(np.sqrt(np.mean(resid_ho ** 2)))
                mae_fit_heldout = float(np.mean(np.abs(resid_ho)))

        rows.append({
            "measure": label,
            "column": col,
            "n_fit": len(fit_sub),
            "p_hat": p_hat,
            "r_squared": float(model.rsquared),
            "rmse_fit": rmse_fit,
            "mae_fit": mae_fit,
            "n_heldout": n_heldout,
            "rmse_heldout": rmse_heldout,
            "mae_heldout": mae_fit_heldout,
        })

    report = pd.DataFrame(rows).sort_values("rmse_fit").reset_index(drop=True)
    report.index += 1
    report.index.name = "Rank (by fit RMSE)"

    print("=" * 80)
    print("PROXY-MAGNITUDE-STATISTICS CHECK "
          f"(model: logM = p * log(measure_ratio), fit excludes heatmap: "
          f"{FIT_EXCLUDE_ALL_HEATMAP})")
    print("=" * 80)
    with pd.option_context("display.width", 160, "display.max_columns", None):
        print(report)
    if not report.empty:
        best = report.iloc[0]
        print(f"\nBest single predictor by fit RMSE: {best['measure']} "
              f"({best['column']}), p_hat={best['p_hat']:.4f}, "
              f"R²={best['r_squared']:.4f}, fit RMSE={best['rmse_fit']:.5f}"
              + (f", heldout RMSE={best['rmse_heldout']:.5f}"
                 if best['rmse_heldout'] is not None else ""))
        comparison_row = comparison[comparison["Model"] == "Linear"]
        if not comparison_row.empty:
            print(f"(For reference, X_COLUMN={X_COLUMN!r}'s own Linear-model "
                  f"AIC/BIC are in the MODEL COMPARISON table printed above - "
                  f"this check is about which MAGNITUDE MEASURE to use, not "
                  f"which functional shape.)")
    print()

    # ------------------------------------------------------------------
    # Bivariate add-on: does each magnitude measure add anything ON TOP
    # of a base model, rather than replace it? By default this checks
    # only the SELECTED model (best_name/best_model, from Section 3's
    # AIC-ranked choice) against X_COLUMN. Two independent/orthogonal
    # booleans (see the config block at the top of this file) widen that:
    #   - CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS: check against every column
    #     in ACTOR_RATIO_OPTIONS, not just X_COLUMN.
    #   - CHECK_MAGNITUDE_ON_ALL_MODELS: check every model shape in
    #     `models` (Linear, Quadratic, Cubic, Cubic (no x²), Tanh,
    #     Rational saturation, Shifted power, Linear+log), not just
    #     best_name.
    # Both True means every model shape × every actor-ratio column, all
    # refit from scratch (see _run_augmented_check_for_column).
    # ------------------------------------------------------------------
    if best_name is None or best_model is None:
        print("(best_name/best_model not provided - skipping the "
              "selected-model augmentation check.)")
        return report, None

    x_cols = ACTOR_RATIO_OPTIONS if CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS else [X_COLUMN]
    models_to_check = (
        list(models.items()) if CHECK_MAGNITUDE_ON_ALL_MODELS
        else [(best_name, best_model)]
    )

    biv_reports = {}
    for x_col in x_cols:
        biv_reports[x_col] = {}
        for model_name, model_obj in models_to_check:
            biv_reports[x_col][model_name] = _run_augmented_check_for_column(
                df_large, model_name, model_obj, measures, fit_mask, heldout_mask, x_col)

    if not CHECK_MAGNITUDE_ON_ALL_ACTOR_RATIOS and not CHECK_MAGNITUDE_ON_ALL_MODELS:
        # Neither widening boolean is set - keep the original return shape
        # (a single DataFrame) rather than the nested dict, for backward
        # compatibility with the pre-widening version of this function.
        return report, biv_reports[X_COLUMN][best_name]
    return report, biv_reports


if CHECK_MAGNITUDE_PROXIES:
    check_magnitude_proxies(df_large, best_name=best_name, best_model=best_model)


# ----------------------------------------------------------------------
# 6c. fit_ratio_combo - a generic "try any combination of ratio columns
#     and functional shapes, all fit jointly" utility, for exploring
#     magnitude-ratio usages beyond what check_magnitude_proxies (6b)
#     hardcodes (a single additive term on top of the SELECTED model).
#     Give it a list of (input_col, function_type) tuples - e.g.
#     [("actor_ratio", "tanh"), ("max_ratio", "linear")] - and it fits
#     logM = f_1(log(input_col_1)) + f_2(log(input_col_2)) + ...
#     with EVERY term's parameters estimated JOINTLY in one nonlinear
#     least-squares fit (not one term at a time), then reports the
#     standard fit-quality numbers so different combos can be compared
#     apples-to-apples against each other and against the models in the
#     main `models` dict above (same AIC/BIC/R² conventions throughout
#     this file: uncentered R², forced-zero-intercept terms, Gaussian-
#     log-likelihood AIC/BIC).
# ----------------------------------------------------------------------

# Supported per-term functional shapes. Each maps to (param_names, the
# term function itself, initial guess p0, (lo, hi) bounds - "None" bound
# entries are filled in per-term at fit time since they depend on that
# term's own data scale - and a formula-string template). All shapes
# mirror the OLS/nonlinear model shapes used elsewhere in this file
# (Section 2/2b), just isolated into single reusable additive terms
# instead of whole standalone models, so a "tanh" term here behaves
# identically to fitting X_COLUMN with the "Tanh" model above.
_COMBO_TERM_TYPES = {
    "linear": (['a'], lambda x, a: a * x),
    "quadratic": (['a', 'b'], lambda x, a, b: a * x + b * x ** 2),
    "cubic": (['a', 'b'], lambda x, a, b: a * x + b * x ** 3),
    "tanh": (['a', 'b'], lambda x, a, b: a * np.tanh(b * x)),
    "rational": (['a', 'b'], lambda x, a, b: a * x / (1 + b * np.abs(x))),
    "shifted_power": (['a', 'p'], lambda x, a, p: np.sign(x) * a * ((1 + np.abs(x)) ** p - 1)),
    "linlog": (['a', 'b', 'c'], lambda x, a, b, c: a * x + b * np.log1p(c * x)),
}
_COMBO_TERM_P0 = {
    "linear": [1.0],
    "quadratic": [1.0, 0.1],
    "cubic": [1.0, -0.1],
    "tanh": [1.0, 1.0],
    "rational": [1.0, 1.0],
    "shifted_power": [1.0, 0.5],
    "linlog": [0.5, 0.5, 0.1],
}
# (lo, hi) per parameter; None entries (linlog's `c`) are resolved per-term
# from that term's own x-range at fit time, same guard _linlog_model /
# _nonlinear_specs use above (keeps 1 + c*x > 0 across the actual data).
_COMBO_TERM_BOUNDS = {
    "linear": ([-np.inf], [np.inf]),
    "quadratic": ([-np.inf, -np.inf], [np.inf, np.inf]),
    "cubic": ([-np.inf, -np.inf], [np.inf, np.inf]),
    "tanh": ([-np.inf, -np.inf], [np.inf, np.inf]),
    "rational": ([-np.inf, 0.0], [np.inf, np.inf]),  # b>=0 so the denominator can't hit 0
    "shifted_power": ([-np.inf, 1e-6], [np.inf, 1 - 1e-6]),  # enforces 0 < p < 1
    "linlog": ([-np.inf, -np.inf, None], [np.inf, np.inf, None]),
}
_COMBO_TERM_FORMULA = {
    "linear": lambda p, col: f"{p[0]:.4f}*log({col})",
    "quadratic": lambda p, col: f"{p[0]:.4f}*log({col}) + {p[1]:.4f}*log({col})^2",
    "cubic": lambda p, col: f"{p[0]:.4f}*log({col}) + {p[1]:.4f}*log({col})^3",
    "tanh": lambda p, col: f"{p[0]:.4f}*tanh({p[1]:.4f}*log({col}))",
    "rational": lambda p, col: f"{p[0]:.4f}*log({col}) / (1 + {p[1]:.4f}*|log({col})|)",
    "shifted_power": lambda p, col: f"sign(log({col}))*{p[0]:.4f}*((1+|log({col})|)^{p[1]:.4f} - 1)",
    "linlog": lambda p, col: f"{p[0]:.4f}*log({col}) + {p[1]:.4f}*log(1 + {p[2]:.4f}*log({col}))",
}
# Friendlier aliases for the function_type string, so callers can use
# names matching this file's model-comparison table ("Tanh", "Rational
# saturation", "Shifted power", "Linear+log", "Cubic (no x²)", etc.)
# interchangeably with the plain lowercase keys above.
_COMBO_TYPE_ALIASES = {
    "rational_saturation": "rational",
    "linear_log": "linlog",
    "linear+log": "linlog",
    "cubic_no_x2": "cubic",
    "cubic_no_x": "cubic",
}


def _normalize_combo_type(function_type):
    """'Tanh' / 'Rational saturation' / 'linear' / ... -> a key in
    _COMBO_TERM_TYPES. Raises ValueError with the valid options if the
    (normalized) type isn't recognized."""
    key = (str(function_type).strip().lower()
           .replace(" ", "_").replace("-", "_")
           .replace("(", "").replace(")", "").replace("²", "2"))
    key = _COMBO_TYPE_ALIASES.get(key, key)
    if key not in _COMBO_TERM_TYPES:
        raise ValueError(f"unknown function_type {function_type!r} "
                          f"(expected one of {sorted(_COMBO_TERM_TYPES)}, "
                          f"or an alias in {sorted(_COMBO_TYPE_ALIASES)})")
    return key


ComboFitResult = namedtuple("ComboFitResult", [
    "terms",            # the (input_col, function_type) list, as given
    "formula",          # e.g. "logM = 0.66*tanh(2.30*log(actor_ratio)) + 1.18*log(max_ratio)"
    "params",           # dict: "col:type:name" -> fitted value (flat, in fit order)
    "n_fit",            # rows used for fitting
    "k_params",         # total number of fitted parameters across all terms
    "r_squared",        # uncentered R^2 on the fit data
    "rsquared_adj",     # uncentered adjusted R^2 on the fit data
    "rmse",             # RMSE on the fit data
    "aic",              # Gaussian-log-likelihood AIC (same convention as `models` above)
    "bic",              # same, BIC
    "llf",              # log-likelihood
    "n_heldout",         # rows available in heldout_mask (None if not applicable)
    "rmse_heldout",     # held-out RMSE (None if n_heldout is 0/None)
    "predict",          # callable: DataFrame with the needed ratio columns (natural scale, >0) -> predicted logM
])


def fit_ratio_combo(df_large, terms, fit_mask=None, heldout_mask=None,
                     target_col="logM", maxfev=20000):
    """Fit logM = sum_i f_i(log(input_col_i)) for an arbitrary list of
    (input_col, function_type) tuples, ALL terms' parameters estimated
    JOINTLY in a single nonlinear least-squares fit (via scipy's
    curve_fit) - e.g.
        fit_ratio_combo(df_large, [("actor_ratio", "tanh"), ("max_ratio", "linear")])
    fits logM = a*tanh(b*log(actor_ratio)) + c*log(max_ratio), estimating
    a, b, c together (not tanh's a/b first and then c on the residual).
    See _COMBO_TERM_TYPES above for the supported function_type values
    ("linear", "quadratic", "cubic", "tanh", "rational", "shifted_power",
    "linlog" - plus a few friendlier aliases like "Tanh" or "Rational
    saturation" matching this file's model-comparison table names).

    df_large should be the raw, un-logged ratio DataFrame (as produced by
    Utilities.indifference_data.all_ratios(), e.g. this file's own
    `df_large`) - every input_col and target_col value is taken straight
    from it and log-transformed internally; rows are dropped if any
    needed column is missing or <= 0 (log requires positive input, same
    convention as X_COLUMN/RESIDUAL_X_COLUMN elsewhere in this file).

    fit_mask/heldout_mask default to this file's usual
    FIT_EXCLUDE_ALL_HEATMAP split (fit on non-heatmap rows, evaluate
    held-out generalization on heatmap-involved rows) - pass your own
    boolean Series (aligned to df_large's index) to override either.

    Returns a ComboFitResult namedtuple (itself a tuple, so it also
    unpacks/indexes positionally) with r_squared, rmse, aic, bic, plus
    the fitted params, a human-readable formula, adjusted R², log-
    likelihood, and held-out RMSE. Raises ValueError if a function_type
    isn't recognized or there are too few usable rows (<3) to fit."""
    if not terms:
        raise ValueError("terms must be a non-empty list of (input_col, function_type) tuples")

    if fit_mask is None:
        fit_mask = ~df_large["is_heatmap"] if FIT_EXCLUDE_ALL_HEATMAP else pd.Series(True, index=df_large.index)
    if heldout_mask is None:
        heldout_mask = df_large["is_heatmap"] if FIT_EXCLUDE_ALL_HEATMAP else pd.Series(False, index=df_large.index)

    normalized = [(col, _normalize_combo_type(ftype)) for col, ftype in terms]
    cols_needed = [col for col, _ in normalized]

    fit_rows = df_large.loc[fit_mask, cols_needed + [target_col]].dropna()
    for c in cols_needed:
        fit_rows = fit_rows[fit_rows[c] > 0]
    n_fit = len(fit_rows)
    if n_fit < 3:
        raise ValueError(f"only {n_fit} usable row(s) for terms={terms!r} "
                          f"(need >=3 rows where every input_col and {target_col!r} "
                          f"are present and positive) - cannot fit")

    xs = [np.log(fit_rows[col].astype(float)).to_numpy() for col in cols_needed]
    y = fit_rows[target_col].astype(float).to_numpy()

    # Assemble the flat parameter vector (concatenated across terms, in
    # order) plus p0/bounds, tracking each term's [start, end) slice into
    # that flat vector so combo_func can dispatch back out to each term's
    # own function.
    param_names, p0, lo_bounds, hi_bounds, term_slices = [], [], [], [], []
    idx = 0
    for x_i, (col, key) in zip(xs, normalized):
        names, _func = _COMBO_TERM_TYPES[key]
        k = len(names)
        term_slices.append((idx, idx + k))
        idx += k
        param_names.extend(f"{col}:{key}:{n}" for n in names)
        p0.extend(_COMBO_TERM_P0[key])
        lo, hi = (list(b) for b in _COMBO_TERM_BOUNDS[key])
        if key == "linlog":
            x_scale = max(float(np.max(np.abs(x_i))), 1e-6)
            lo[2], hi[2] = -1.0 / (2 * x_scale), 1.0 / (2 * x_scale)
        lo_bounds.extend(lo)
        hi_bounds.extend(hi)

    X_stack = np.vstack(xs)  # shape (n_terms, n_fit)

    def combo_func(X, *params):
        total = np.zeros(X.shape[1])
        for i, (col, key) in enumerate(normalized):
            _names, func = _COMBO_TERM_TYPES[key]
            start, end = term_slices[i]
            total = total + func(X[i], *params[start:end])
        return total

    popt, pcov = curve_fit(combo_func, X_stack, y, p0=p0,
                            bounds=(lo_bounds, hi_bounds), maxfev=maxfev)

    resid = y - combo_func(X_stack, *popt)
    rss = float(np.sum(resid ** 2))
    k_params = len(popt)
    sigma2 = max(rss / n_fit, 1e-300)
    llf = -0.5 * n_fit * (np.log(2 * np.pi) + np.log(sigma2) + 1)
    aic = -2 * llf + 2 * k_params
    bic = -2 * llf + k_params * np.log(n_fit)
    sst_uncentered = float(np.sum(y ** 2))
    r_squared = 1 - rss / sst_uncentered if sst_uncentered > 0 else float('nan')
    df_resid = n_fit - k_params
    rsquared_adj = (1 - (1 - r_squared) * n_fit / df_resid) if df_resid > 0 else float('nan')
    rmse = float(np.sqrt(rss / n_fit))

    params = dict(zip(param_names, popt))
    formula = " + ".join(
        _COMBO_TERM_FORMULA[key](popt[start:end], col)
        for (col, key), (start, end) in zip(normalized, term_slices)
    )
    formula = f"logM = {formula}"

    def predict(pred_df):
        x_pred = [np.log(pred_df[col].astype(float)).to_numpy() for col in cols_needed]
        return combo_func(np.vstack(x_pred), *popt)

    n_heldout = rmse_heldout = None
    ho_rows = df_large.loc[heldout_mask, cols_needed + [target_col]].dropna()
    for c in cols_needed:
        ho_rows = ho_rows[ho_rows[c] > 0]
    n_heldout = len(ho_rows)
    if n_heldout > 0:
        y_ho = ho_rows[target_col].astype(float).to_numpy()
        resid_ho = y_ho - predict(ho_rows)
        rmse_heldout = float(np.sqrt(np.mean(resid_ho ** 2)))

    return ComboFitResult(
        terms=list(terms), formula=formula, params=params, n_fit=n_fit,
        k_params=k_params, r_squared=r_squared, rsquared_adj=rsquared_adj,
        rmse=rmse, aic=aic, bic=bic, llf=llf, n_heldout=n_heldout,
        rmse_heldout=rmse_heldout, predict=predict,
    )


