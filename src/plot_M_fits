models['Cubic (no x²)'] = smf.ols('y_log ~ x + I(x**3) - 1', data=df).fit()

# B‑spline with 4 degrees of freedom (lower than 5 to be safer)
#models['Spline (df=4)'] = smf.ols('y_log ~ bs(x, df=4, degree=3)', data=df).fit()

# ----------------------------------------------------------------------
# 2b. Nonlinear (non-OLS) model shapes - can't be expressed as a
#     linear-in-parameters patsy formula, so these are fit directly via
#     scipy.optimize.curve_fit rather than statsmodels.ols, then wrapped
#     in NonlinearFitResult below so they sit in the SAME `models` dict
#     and go through the exact same comparison table / best-model
#     selection / plotting / residual code as the OLS models above, with
#     no special-casing needed downstream. All four pass through the
#     origin (x=0 => y=0) by construction, matching this file's
#     fixed-zero-intercept convention (see section 2's comment).
# ----------------------------------------------------------------------

def _tanh_model(x, a, b):
    """log(M) = a * tanh(b * x) - saturating S-curve: log(M) -> +-a as
    x -> +-infinity. Useful if the true relationship flattens out at
    extreme ratios instead of growing without bound the way the OLS
    polynomials above do."""
    return a * np.tanh(b * x)


def _rational_model(x, a, b):
    """log(M) = a*x / (1 + b*|x|) - rational ("Michaelis-Menten style")
    saturation: behaves linearly with slope a near x=0, and flattens
    toward +-a/b as |x| grows, without tanh's hard S-curve shape."""
    return a * x / (1 + b * np.abs(x))


def _shifted_power_model(x, a, p):
    """log(M) = sign(x) * a * ((1+|x|)^p - 1), with 0 < p < 1 enforced via
    curve_fit bounds below - a sub-linear power law in the SHIFTED
    magnitude (1+|x|) rather than a bare power of x itself, so it stays
    well-defined (and antisymmetric, and exactly 0) at x=0."""
    return np.sign(x) * a * ((1 + np.abs(x)) ** p - 1)


def _linlog_model(x, a, b, c):
    """log(M) = a*x + b*log(1 + c*x) - a linear term plus a logarithmic
    correction. Uses np.log1p(c*x) (== log(1+c*x), but numerically stable
    near c*x=0) - the `c` bound below (see _nonlinear_specs) keeps
    1 + c*x > 0 across the actual data range so this never hits log's
    domain error."""
    return a * x + b * np.log1p(c * x)


class NonlinearFitResult:
    """Minimal stand-in for a statsmodels regression result. Implements
    only what the comparison table / best-model selection / plotting /
    residual code below actually calls on a fitted model - .aic, .bic,
    .rsquared_adj, .predict(df), .summary() - computed with the SAME
    Gaussian-log-likelihood convention statsmodels uses for OLS (see aic/
    bic below), so its AIC/BIC are directly comparable to the OLS models'
    values in the same table, and R^2/Adj-R^2 use the uncentered
    (no-intercept) convention to match this file's forced-zero-intercept
    OLS models."""

    def __init__(self, name, func, param_names, x, y, p0, bounds=None, maxfev=20000):
        self.name = name
        self.func = func
        self._param_names = param_names
        self._x = np.asarray(x, dtype=float)
        self._y = np.asarray(y, dtype=float)
        popt, pcov = curve_fit(func, x, y, p0=p0, bounds=bounds or (-np.inf, np.inf), maxfev=maxfev)
        self.popt = popt
        self.pcov = pcov
        self.params = dict(zip(param_names, popt))
        resid = self._y - func(self._x, *popt)
        self.resid = resid
        self.nobs = len(y)
        self.k_params = len(popt)
        self.df_resid = self.nobs - self.k_params
        self.rss = float(np.sum(resid ** 2))
        sigma2 = max(self.rss / self.nobs, 1e-300)  # guard log(0) for a near-perfect fit
        self.llf = -0.5 * self.nobs * (np.log(2 * np.pi) + np.log(sigma2) + 1)
        self.aic = -2 * self.llf + 2 * self.k_params
        self.bic = -2 * self.llf + self.k_params * np.log(self.nobs)
        sst_uncentered = float(np.sum(self._y ** 2))
        self.rsquared = 1 - self.rss / sst_uncentered if sst_uncentered > 0 else float('nan')
        self.rsquared_adj = (1 - (1 - self.rsquared) * self.nobs / self.df_resid) if self.df_resid > 0 else float('nan')

        # Parameter standard errors / t-stats / p-values / 95% CI - from
        # curve_fit's own covariance matrix, same interpretation as an OLS
        # coefficient table (asymptotic/large-sample approximation, since
        # there's no exact finite-sample theory for a nonlinear model the
        # way there is for OLS).
        self.stderr = np.sqrt(np.clip(np.diag(pcov), 0, None))
        with np.errstate(divide='ignore', invalid='ignore'):
            self.tvalues = np.where(self.stderr > 0, popt / self.stderr, np.nan)
        self.pvalues = 2 * stats.t.sf(np.abs(self.tvalues), self.df_resid) if self.df_resid > 0 else np.full(self.k_params, np.nan)
        _t_crit = stats.t.ppf(0.975, self.df_resid) if self.df_resid > 0 else np.nan
        self.conf_int = np.column_stack([popt - _t_crit * self.stderr, popt + _t_crit * self.stderr])

        # F-statistic (uncentered convention, matching the OLS models'
        # "- 1"/no-intercept setup): ESS = SST_uncentered - RSS, same
        # decomposition used for R^2 above.
        ess = sst_uncentered - self.rss
        if self.df_resid > 0 and self.k_params > 0:
            self.fvalue = (ess / self.k_params) / (self.rss / self.df_resid)
            self.f_pvalue = stats.f.sf(self.fvalue, self.k_params, self.df_resid)
        else:
            self.fvalue = self.f_pvalue = float('nan')

        # Residual diagnostics - identical tests statsmodels prints in its
        # OLS summary (Omnibus/normality, Jarque-Bera, Durbin-Watson).
        try:
            self.omnibus, self.omnibus_pvalue = omni_normtest(resid)
        except Exception:
            self.omnibus = self.omnibus_pvalue = float('nan')
        try:
            jb, jb_pvalue, jb_skew, jb_kurtosis = jarque_bera(resid)
        except Exception:
            jb, jb_pvalue, jb_skew, jb_kurtosis = (float('nan'),) * 4
        self.jarque_bera = jb
        self.jarque_bera_pvalue = jb_pvalue
        self.skew = jb_skew
        self.kurtosis = jb_kurtosis
        self.durbin_watson = durbin_watson(resid)

        # Condition number - statsmodels' analog for OLS uses the design
        # matrix's eigenvalues; there's no fixed design matrix here, so
        # this uses the parameter covariance matrix's eigenvalues instead
        # (pcov ~ sigma^2 * inv(J'J), where J is the model's Jacobian at
        # the optimum - same ill-conditioning signal, just via a
        # nonlinear-least-squares-appropriate matrix).
        try:
            _eigs = np.linalg.eigvalsh(np.linalg.inv(pcov))
            _eigs = _eigs[_eigs > 0]
            self.cond_no = float(np.sqrt(_eigs.max() / _eigs.min())) if len(_eigs) else float('nan')
        except np.linalg.LinAlgError:
            self.cond_no = float('nan')

    def predict(self, pred_df):
        x_arr = pred_df['x'].to_numpy()
        return pd.Series(self.func(x_arr, *[self.params[n] for n in self._param_names]), index=pred_df.index)

    def summary(self):
        """Statsmodels-OLS-style summary text (same information content:
        fit-quality header block, per-parameter coefficient table with
        std err/t/P>|t|/95% CI, and the residual-diagnostics block), built
        by hand since statsmodels' own Summary class is tied to its own
        model objects and can't be reused directly for a curve_fit result."""
        name_w = max(len(n) for n in self._param_names)
        lines = []
        lines.append("=" * 87)
        lines.append(f"{'Nonlinear Least Squares Results (' + self.name + ')':^87}")
        lines.append("=" * 87)
        # Fixed column widths (label, value) on each side, so alignment
        # never breaks regardless of how long a model's name is - long
        # values are truncated with "..." rather than pushed out of column.
        _LEFT_LABEL_W, _LEFT_VAL_W = 18, 20
        _RIGHT_LABEL_W, _RIGHT_VAL_W = 29, 16

        def _fit(value, width):
            value = str(value)
            return value if len(value) <= width else value[:width - 3] + "..."

        left = [
            ("Dep. Variable:", "y_log"),
            ("Model:", "Nonlinear"),
            ("Method:", "curve_fit (NLS)"),
            ("No. Observations:", str(self.nobs)),
            ("Df Residuals:", str(self.df_resid)),
            ("Df Model:", str(self.k_params)),
        ]
        right = [
            ("R-squared (uncentered):", f"{self.rsquared:.3f}"),
            ("Adj. R-squared (uncentered):", f"{self.rsquared_adj:.3f}"),
            ("F-statistic:", f"{self.fvalue:.4g}"),
            ("Prob (F-statistic):", f"{self.f_pvalue:.3g}"),
            ("Log-Likelihood:", f"{self.llf:.3f}"),
            ("AIC:", f"{self.aic:.2f}"),
            ("BIC:", f"{self.bic:.2f}"),
        ]
        for i in range(max(len(left), len(right))):
            if i < len(left):
                l = f"{_fit(left[i][0], _LEFT_LABEL_W):<{_LEFT_LABEL_W}}{_fit(left[i][1], _LEFT_VAL_W):>{_LEFT_VAL_W}}"
            else:
                l = " " * (_LEFT_LABEL_W + _LEFT_VAL_W)
            if i < len(right):
                r = f"{_fit(right[i][0], _RIGHT_LABEL_W):<{_RIGHT_LABEL_W}}{_fit(right[i][1], _RIGHT_VAL_W):>{_RIGHT_VAL_W}}"
            else:
                r = ""
            lines.append(f"{l}   {r}")
        lines.append("=" * 87)
        header = f"{'':<{name_w}} {'coef':>10} {'std err':>10} {'t':>8} {'P>|t|':>8} {'[0.025':>10} {'0.975]':>10}"
        lines.append(header)
        lines.append("-" * 87)
        for i, pname in enumerate(self._param_names):
            lines.append(
                f"{pname:<{name_w}} {self.popt[i]:>10.4f} {self.stderr[i]:>10.4f} "
                f"{self.tvalues[i]:>8.3f} {self.pvalues[i]:>8.3f} "
                f"{self.conf_int[i, 0]:>10.4f} {self.conf_int[i, 1]:>10.4f}"
            )
        lines.append("=" * 87)
        lines.append(
            f"Omnibus: {self.omnibus:>16.3f}   Durbin-Watson: {self.durbin_watson:>17.3f}"
        )
        lines.append(
            f"Prob(Omnibus): {self.omnibus_pvalue:>10.3f}   Jarque-Bera (JB): {self.jarque_bera:>14.3f}"
        )
        lines.append(
            f"Skew: {self.skew:>19.3f}   Prob(JB): {self.jarque_bera_pvalue:>22.3g}"
        )
        lines.append(
            f"Kurtosis: {self.kurtosis:>15.3f}   Cond. No.: {self.cond_no:>21.3g}"
        )
        lines.append("=" * 87)
        lines.append("Notes:")
        lines.append("[1] R2 is computed without centering (uncentered) since the model has no")
        lines.append("    intercept term (this file forces every model through the origin).")
        lines.append("[2] Standard errors are the asymptotic (large-sample) curve_fit covariance")
        lines.append("    estimate - there is no exact finite-sample theory for a nonlinear model")
        lines.append("    the way there is for OLS, so treat these as approximate.")
        lines.append("[3] Cond. No. uses the parameter covariance matrix's eigenvalues (there is no")
        lines.append("    fixed design matrix for a nonlinear model) - same ill-conditioning signal")
        lines.append("    as OLS's Cond. No., computed differently.")
        return "\n".join(lines)


_x_arr = df['x'].to_numpy(dtype=float)
_y_arr = df['y_log'].to_numpy(dtype=float)
# Scale used to bound `c` in the linear+log model below, so 1+c*x can
# never go non-positive across the actual data range (keeps log1p safe
# during optimization, not just at the final fitted value).
_x_scale = max(float(np.max(np.abs(_x_arr))), 1e-6) if len(_x_arr) else 1.0

_nonlinear_specs = [
    ("Tanh", _tanh_model, ['a', 'b'], [1.0, 1.0], None),
    ("Rational saturation", _rational_model, ['a', 'b'], [1.0, 1.0],
     ([-np.inf, 0.0], [np.inf, np.inf])),  # b>=0 so the denominator can't hit 0
    ("Shifted power", _shifted_power_model, ['a', 'p'], [1.0, 0.5],
     ([-np.inf, 1e-6], [np.inf, 1 - 1e-6])),  # enforces 0 < p < 1
    ("Linear+log", _linlog_model, ['a', 'b', 'c'], [0.5, 0.5, 0.1],
     ([-np.inf, -np.inf, -1.0 / (2 * _x_scale)], [np.inf, np.inf, 1.0 / (2 * _x_scale)])),
]

for _name, _func, _param_names, _p0, _bounds in _nonlinear_specs:
    try:
        models[_name] = NonlinearFitResult(_name, _func, _param_names, _x_arr, _y_arr, _p0, bounds=_bounds)
    except (RuntimeError, ValueError) as _e:
        print(f"WARNING: nonlinear fit '{_name}' failed to converge ({_e}) - excluded from comparison.")

# ----------------------------------------------------------------------
# Recipes for each of the 8 model shapes in `models` - term builders (for
# the OLS-formula ones) and param_names/bounds lookups (for the
# curve_fit-based ones), plus human-readable formula templates. Defined
# here (before Section 3) so the model comparison table below can print
# a fitted formula for every model, not just whichever one gets selected;
# also reused by check_magnitude_proxies (section 6b) to augment the
# selected model with an additive magnitude term.
# ----------------------------------------------------------------------
_OLS_MODEL_TERMS = {
    "Linear": [("x", lambda x: x)],
    "Quadratic": [("x", lambda x: x), ("x2", lambda x: x ** 2)],
    "Cubic": [("x", lambda x: x), ("x3", lambda x: x ** 3)],
    "Cubic (no x²)": [("x", lambda x: x), ("x3", lambda x: x ** 3)],
}
_NONLINEAR_LOOKUP = {spec[0]: spec for spec in _nonlinear_specs}

# Human-readable formula templates for each model shape, given its fitted
# base parameters IN THE SAME ORDER as _OLS_MODEL_TERMS/_NONLINEAR_LOOKUP's
# param_names (a, b[, c/p]) - `x` in these strings always means
# log(X_COLUMN) (or, in check_magnitude_proxies, log of whichever column
# is being checked). Used only for printed reports; has no effect on any
# fit itself.
_BASE_FORMULA_TEMPLATES = {
    "Linear": lambda p: f"{p[0]:.4f}*x",
    "Quadratic": lambda p: f"{p[0]:.4f}*x + {p[1]:.4f}*x^2",
    "Cubic": lambda p: f"{p[0]:.4f}*x + {p[1]:.4f}*x^3",
    "Cubic (no x²)": lambda p: f"{p[0]:.4f}*x + {p[1]:.4f}*x^3",
    "Tanh": lambda p: f"{p[0]:.4f}*tanh({p[1]:.4f}*x)",
    "Rational saturation": lambda p: f"{p[0]:.4f}*x / (1 + {p[1]:.4f}*|x|)",
    "Shifted power": lambda p: f"sign(x)*{p[0]:.4f}*((1+|x|)^{p[1]:.4f} - 1)",
    "Linear+log": lambda p: f"{p[0]:.4f}*x + {p[1]:.4f}*log(1 + {p[2]:.4f}*x)",
}


def _param_names_for(best_name):
    """Parameter names, in fitted-array order, for a model shape - the
    same names _BASE_FORMULA_TEMPLATES' lambdas index into positionally."""
    if best_name in _OLS_MODEL_TERMS:
        return [name for name, _ in _OLS_MODEL_TERMS[best_name]]
    if best_name in _NONLINEAR_LOOKUP:
        return list(_NONLINEAR_LOOKUP[best_name][2])
    raise ValueError(f"no param names for best_name={best_name!r}")


def _model_coeffs_array(name, model):
    """The fitted coefficients for an already-fit model (an smf.ols
    result for the 4 OLS shapes, or a NonlinearFitResult for the 4
    curve_fit shapes), as a plain array in the same order
    _param_names_for/_BASE_FORMULA_TEMPLATES expect. Works for anything
    already sitting in the `models` dict."""
    if name in _OLS_MODEL_TERMS:
        return np.asarray(model.params)
    if name in _NONLINEAR_LOOKUP:
        return np.asarray(model.popt)
    raise ValueError(f"no coefficient recipe for model name={name!r}")


def _format_model_formula(best_name, params, magnitude_col=None, q=None):
    """'logM = <base formula>' (optionally with '+ q*log(<magnitude_col>)'
    appended) using _BASE_FORMULA_TEMPLATES, falling back to a generic
    listing if best_name isn't in the template dict (shouldn't happen for
    any of this file's 8 model shapes)."""
    template = _BASE_FORMULA_TEMPLATES.get(best_name)
    if template is not None:
        base_str = template(params)
    else:
        names = _param_names_for(best_name)
        base_str = ", ".join(f"{n}={v:.4f}" for n, v in zip(names, params))
    formula = f"logM = {base_str}"
    if magnitude_col is not None:
        formula += f" + ({q:.4f})*log({magnitude_col})"
    return formula


