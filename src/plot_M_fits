# ----------------------------------------------------------------------
models = {}

# Linear
models['Linear'] = smf.ols('y_log ~ x - 1', data=df).fit()

# Quadratic
models['Quadratic'] = smf.ols('y_log ~ x + I(x**2) - 1', data=df).fit()

# Cubic
