    if RESIDUAL_X_COLUMN == "y_pred":
        return frame['y_pred'].to_numpy(), 'Fitted log(M)'
    vals = np.log(df_tau.loc[frame.index, RESIDUAL_X_COLUMN].astype(float)).to_numpy()
    return vals, f'log({RESIDUAL_X_COLUMN})'


